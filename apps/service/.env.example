# Copy to a PRIVATE environment file managed by your server operator.
# Never commit actual secrets; only the web public anon key belongs in a browser build.
HOST=127.0.0.1
PORT=8787
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=REPLACE_WITH_PUBLIC_ANON_KEY
SUPABASE_SECRET_KEY=REPLACE_WITH_SERVER_ONLY_SERVICE_ROLE_KEY
PRECIFY_ENCRYPTION_KEY=REPLACE_WITH_64_HEX_CHARACTERS
PRECIFY_WEB_ORIGIN=https://precify.example.com
PRECIFY_PUBLIC_URL=https://api.precify.example.com
META_APP_ID=
META_APP_SECRET=
META_GRAPH_VERSION=v26.0

# Web Vite variables (safe for public bundles; NEVER VITE_ the service key):
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=REPLACE_WITH_PUBLIC_ANON_KEY
VITE_PRECIFY_API_URL=https://api.precify.example.com

# Legacy keys SUPABASE_ANON_KEY and SUPABASE_SERVICE_KEY remain accepted as fallback.
# Keep SUPABASE_SECRET_KEY private: never use VITE_ prefix or commit this file with secrets.
