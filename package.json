{
  "name": "precify-colombia",
  "version": "2.0.0",
  "private": true,
  "packageManager": "pnpm@10.34.7",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "pnpm --filter @precify-colombia/core build && pnpm --filter @precify-colombia/web dev",
    "typecheck": "pnpm --filter @precify-colombia/core build && pnpm -r typecheck",
    "lint": "pnpm --filter @precify-colombia/core build && node scripts/lint.mjs && pnpm -r typecheck",
    "test": "pnpm -r test",
    "build": "pnpm -r build",
    "verify": "node scripts/verify-local.mjs",
    "verify:core": "pnpm --filter @precify-colombia/core build && node scripts/verify-core-package.mjs"
  }
}
